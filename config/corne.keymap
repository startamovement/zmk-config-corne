#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define DEF 0
#define NAV 1
#define SYM 2
#define ADJ 3
#define EXTRA 4

&sk {
    release-after-ms = <900>;
    quick-release;
};

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <180>;
            require-prior-idle-ms = <120>; /* tune to taste */
        };

        para: para {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_PARENTHESIS>, <&kp RIGHT_PARENTHESIS>;
        };

        caps: caps {
            compatible = "zmk,behavior-caps-word";
            #binding-cells = <0>;
            continue-list = <MINUS BACKSPACE UNDERSCORE>;
        };

        paraless: paraless {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&kp LEFT_PARENTHESIS>, <&kp LESS_THAN>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        paragreat: paragreat {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&kp RIGHT_PARENTHESIS>, <&kp GREATER_THAN>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        shift_caps: shift_caps {
            compatible = "zmk,behavior-tap-dance";
            label = "SHIFT_CAPS";
            #binding-cells = <0>;
            bindings = <&hold_sticktap LEFT_SHIFT LEFT_SHIFT>, <&kp CAPS>;
        };

        layer_tap_repeat: layer_tap_repeat {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&mo>, <&kp>;

            quick-tap-ms = <180>;
            require-prior-idle-ms = <120>;
            label = "LAYER_TAP_REPEAT";
        };

        hold_sticktap: hold_sticktap {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_STICKTAP";
            bindings = <&kp>, <&sk>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };

        hrm_backup: hrm_backup {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <180>;
            require-prior-idle-ms = <120>;
            label = "HRM_BACKUP";
        };

        ht_balanced: ht_balanced {
            compatible = "zmk,behavior-hold-tap";
            label = "HT_BALANCED";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <180>;
            flavor = "balanced";
            hold-trigger-on-release;
        };

        terminal_tmux_tapdance: terminal_tmux_tapdance {
            compatible = "zmk,behavior-tap-dance";
            label = "TERMINAL_TMUX_TAPDANCE";
            #binding-cells = <0>;
            bindings = <&ctrl_space>, <&ctrl_backtick>;
        };

        caps_word_layer_tap: caps_word_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <220>;
            flavor = "tap-preferred";
            bindings = <&mo>, <&sticky_shift_caps_word>;

            quick-tap-ms = <200>;
            require-prior-idle-ms = <120>;
            label = "CAPS_WORD_LAYER_TAP";
        };

        hrm_left: hrm_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <180>;
            require-prior-idle-ms = <120>;
            label = "HRM_LEFT";
            hold-trigger-key-positions = <6 10 11 18 19 20 21 22 23 30 31 32 33 34 35 7 8 9 39 40 41>;
            hold-trigger-on-release;
        };

        hrm_right: hrm_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <180>;
            require-prior-idle-ms = <120>;
            label = "HRM_RIGHT";
            hold-trigger-key-positions = <0 1 5 12 13 14 15 16 17 24 25 26 27 28 29 2 3 4 5 36 37 38>;
            hold-trigger-on-release;
        };

        sticky_shift_caps: sticky_shift_caps {
            compatible = "zmk,behavior-mod-morph";
            label = "STICKY_SHIFT_CAPS";
            bindings = <&sk LEFT_SHIFT>, <&caps_word>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        sticky_shift_caps_word: sticky_shift_caps_word {
            compatible = "zmk,behavior-tap-dance";
            label = "STICKY_SHIFT_CAPS_WORD";
            #binding-cells = <0>;
            bindings = <&sk LEFT_SHIFT>, <&caps_word>;
        };

        hr_shift: hr_shift {
            compatible = "zmk,behavior-hold-tap";
            label = "HR_SHIFT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <180>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            hold-trigger-on-release;
        };

        caps_word_capslock: caps_word_capslock {
            compatible = "zmk,behavior-mod-morph";
            label = "CAPS_WORD_CAPSLOCK";
            bindings = <&caps_word>, <&kp CAPS>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        to_nav: to_nav {
            compatible = "zmk,behavior-tap-dance";
            label = "TO_NAV";
            #binding-cells = <0>;
            bindings = <&none>, <&to 1>;
        };

        to_mouse: to_mouse {
            compatible = "zmk,behavior-tap-dance";
            label = "TO_MOUSE";
            #binding-cells = <0>;
            bindings = <&none>, <&to 2>;
        };

        to_num: to_num {
            compatible = "zmk,behavior-tap-dance";
            label = "TO_NUM";
            #binding-cells = <0>;
            bindings = <&none>, <&to 4>;
        };

        to_sym: to_sym {
            compatible = "zmk,behavior-tap-dance";
            label = "TO_SYM";
            #binding-cells = <0>;
            bindings = <&none>, <&to 5>;
        };

        to_media: to_media {
            compatible = "zmk,behavior-tap-dance";
            label = "TO_MEDIA";
            #binding-cells = <0>;
            bindings = <&none>, <&to 3>;
        };

        to_fun: to_fun {
            compatible = "zmk,behavior-tap-dance";
            label = "TO_FUN";
            #binding-cells = <0>;
            bindings = <&none>, <&to 6>;
        };

        to_base: to_base {
            compatible = "zmk,behavior-tap-dance";
            label = "TO_BASE";
            #binding-cells = <0>;
            bindings = <&none>, <&to 0>;
        };
    };

    combos {
        compatible = "zmk,combos";

        ctrl_space_combo {
            bindings = <&ctrl_space>;
            key-positions = <13 40>;
            layers = <0>;
        };
    };

    //

    macros {
        ctrl_backtick: ctrl_backtick {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LC(GRAVE)>,
                <&macro_release>,
                <&kp LC(GRAVE)>;

            label = "CTRL_BACKTICK";
        };

        ctrl_space: ctrl_space {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LC(SPACE)>,
                <&macro_release>,
                <&kp LC(SPACE)>;

            label = "CTRL_SPACE";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        BASE {
            display-name = "Base";

            // -----------------------------------------------------------------------------------------
            // |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  |
            // |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |
            // |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  |
            // | GUI | CTRL | SHFT | LWR | SPC |   | ENT | RSE  | BKSP | ALT | ESC |

            bindings = <
&key_repeat  &kp Q                     &kp W                               &kp E                    &kp R                          &kp T           &kp Y        &kp U                    &kp I                   &kp O                                   &kp P                 &terminal_tmux_tapdance
&none        &hrm_left LEFT_CONTROL A  &hrm_left LEFT_ALT S                &hrm_left LEFT_GUI D     &hr_shift LEFT_SHIFT F         &kp G           &kp H        &hr_shift RIGHT_SHIFT J  &hrm_right RIGHT_GUI K  &hrm_right RIGHT_ALT L                  &hrm_right RCTRL SQT  &none
&none        &kp Z                     &hrm_left LA(LC(LG(LEFT_SHIFT))) X  &kp C                    &kp V                          &kp B           &kp N        &kp M                    &kp COMMA               &hrm_right RA(RC(RG(RIGHT_SHIFT))) DOT  &kp SLASH             &none
                                                                           &layer_tap_repeat 3 DEL  &layer_tap_repeat 1 BACKSPACE  &lt 2 ESCAPE    &lt 5 ENTER  &lt 4 SPACE              &lt 6 TAB
            >;
        };

        NAV {
            bindings = <
&trans  &trans            &trans        &trans        &to_base        &trans    &kp LG(LA(LEFT))  &kp LG(LS(LEFT_BRACKET))  &kp LS(LG(RIGHT_BRACKET))  &kp LG(LA(RIGHT))  &trans               &trans
&trans  &kp LEFT_CONTROL  &kp LEFT_ALT  &kp LEFT_GUI  &kp LEFT_SHIFT  &trans    &kp LEFT          &kp DOWN_ARROW            &kp UP_ARROW               &kp RIGHT          &caps_word_capslock  &trans
&trans  &trans            &trans        &to_num       &to_nav         &trans    &kp HOME          &kp PAGE_DOWN             &kp PAGE_UP                &kp END            &kp INSERT           &trans
                                        &trans        &trans          &trans    &trans            &trans                    &trans
            >;

            label = "Nav";
        };

        MOUSE {
            bindings = <
&trans  &trans            &trans        &trans        &to_base        &trans    &trans             &trans            &trans             &trans            &trans               &trans
&trans  &kp LEFT_CONTROL  &kp LEFT_ALT  &kp LEFT_GUI  &kp LEFT_SHIFT  &trans    &mmv MOVE_X(-600)  &mmv MOVE_Y(600)  &mmv MOVE_Y(-600)  &mmv MOVE_X(600)  &caps_word_capslock  &trans
&trans  &trans            &trans        &to_sym       &to_mouse       &trans    &msc SCRL_RIGHT    &msc SCRL_UP      &msc SCRL_DOWN     &msc SCRL_LEFT    &kp INSERT           &trans
                                        &trans        &trans          &trans    &mkp RCLK          &mkp LCLK         &mkp MCLK
            >;

            label = "Mouse";
        };

        MEDIA {
            bindings = <
&trans  &trans            &trans        &trans        &to_base        &trans    &trans          &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &trans        &trans        &kp LG(LA(C_POWER))
&trans  &kp LEFT_CONTROL  &kp LEFT_ALT  &kp LEFT_GUI  &kp LEFT_SHIFT  &trans    &kp C_PREVIOUS  &kp C_VOLUME_DOWN     &kp C_VOLUME_UP       &kp C_NEXT    &trans        &trans
&trans  &trans            &trans        &to_fun       &to_media       &trans    &bt BT_SEL 0    &bt BT_SEL 1          &bt BT_SEL 2          &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR
                                        &trans        &trans          &trans    &kp C_STOP      &kp C_PLAY_PAUSE      &kp C_MUTE
            >;

            label = "Media";
        };

        NUM {
            display-name = "Numbers";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            // | GUI | CTRL | SHFT | LWR | SPC |   | ENT | RSE  | BKSP | ALT | ESC |

            bindings = <
&trans  &kp LEFT_BRACKET  &kp N7        &kp N8        &kp N9        &kp RIGHT_BRACKET    &trans  &to_base         &trans         &trans         &trans     &trans
&trans  &kp SEMICOLON     &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp EQUAL            &trans  &kp RIGHT_SHIFT  &kp RIGHT_GUI  &kp RIGHT_ALT  &kp RCTRL  &trans
&trans  &kp GRAVE         &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp BACKSLASH        &trans  &to_num          &to_nav        &trans         &trans     &trans
                                        &kp PERIOD    &kp N0        &kp MINUS            &trans  &trans           &trans
            >;
        };

        SYM {
            display-name = "Symbols";
            bindings = <
&trans  &kp LEFT_BRACE  &kp AMPERSAND    &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_BRACE    &trans  &to_base         &trans         &trans         &trans     &trans
&trans  &kp COLON       &kp DOLLAR       &kp PERCENT   &kp CARET             &kp PLUS           &trans  &kp RIGHT_SHIFT  &kp RIGHT_GUI  &kp RIGHT_ALT  &kp RCTRL  &trans
&trans  &kp TILDE       &kp EXCLAMATION  &kp AT_SIGN   &kp HASH              &kp PIPE           &trans  &to_sym          &to_mouse      &trans         &trans     &trans
                                         &paraless     &paragreat            &kp UNDERSCORE     &trans  &trans           &trans
            >;
        };

        Fun {
            display-name = "Function";
            bindings = <
&trans  &kp F12  &kp F7  &kp F8  &kp F9  &kp LG(LS(LC(NUMBER_4)))    &trans  &to_base         &trans         &trans         &trans             &trans
&trans  &kp F11  &kp F4  &kp F5  &kp F6  &kp LG(LS(NUMBER_4))        &trans  &kp RIGHT_SHIFT  &kp RIGHT_GUI  &kp RIGHT_ALT  &kp RIGHT_CONTROL  &trans
&trans  &kp F10  &kp F1  &kp F2  &kp F3  &kp LC(LG(SPACE))           &trans  &to_fun          &to_media      &trans         &trans             &trans
                         &trans  &trans  &trans                      &trans  &trans           &trans
            >;
        };

        layer_8 {
            label = "Mouse_backup";
            bindings = <
&trans  &trans            &trans        &trans        &trans          &trans    &kp LG(V)        &kp LG(C)       &kp LG(X)       &kp LG(Z)        &kp LG(LS(Z))  &trans
&trans  &kp LEFT_CONTROL  &kp LEFT_ALT  &kp LEFT_GUI  &kp LEFT_SHIFT  &trans    &mmv MOVE_LEFT   &mmv MOVE_DOWN  &mmv MOVE_UP    &mmv MOVE_RIGHT  &caps          &trans
&trans  &trans            &trans        &trans        &trans          &trans    &msc SCRL_RIGHT  &msc SCRL_UP    &msc SCRL_DOWN  &msc SCRL_LEFT   &kp INSERT     &trans
                                        &trans        &trans          &to 0     &mkp RCLK        &mkp LCLK       &mkp MCLK
            >;
        };
    };
};
