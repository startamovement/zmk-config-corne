#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define DEF 0
#define NAV 1
#define SYM 2
#define ADJ 3
#define EXTRA 4

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <180>;
            require-prior-idle-ms = <120>; /* tune to taste */
        };

        para: para {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_PARENTHESIS>, <&kp RIGHT_PARENTHESIS>;
        };

        caps: caps {
            compatible = "zmk,behavior-caps-word";
            #binding-cells = <0>;
            continue-list = <MINUS BACKSPACE UNDERSCORE>;
        };

        paraless: paraless {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&kp LEFT_PARENTHESIS>, <&kp LESS_THAN>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        paragreat: paragreat {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&kp RIGHT_PARENTHESIS>, <&kp GREATER_THAN>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        shift_caps: shift_caps {
            compatible = "zmk,behavior-tap-dance";
            label = "SHIFT_CAPS";
            #binding-cells = <0>;
            bindings = <&hold_sticktap LEFT_SHIFT LEFT_SHIFT>, <&kp CAPS>;
        };

        layer_tap_repeat: layer_tap_repeat {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&mo>, <&kp>;

            quick-tap-ms = <180>;
            require-prior-idle-ms = <120>;
            label = "LAYER_TAP_REPEAT";
        };

        hold_sticktap: hold_sticktap {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_STICKTAP";
            bindings = <&kp>, <&sk>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };

        hrm_backup: hrm_backup {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <180>;
            require-prior-idle-ms = <120>;
            label = "HRM_BACKUP";
        };

        hold_preferred: hold_preferred {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_PREFERRED";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        terminal_tmux_tapdance: terminal_tmux_tapdance {
            compatible = "zmk,behavior-tap-dance";
            label = "TERMINAL_TMUX_TAPDANCE";
            #binding-cells = <0>;
            bindings = <&kp LC(SPACE)>, <&kp LC(GRAVE)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        ctrl_space_combo {
            bindings = <&kp LC(SPACE)>;
            key-positions = <13 40>;
            layers = <0>;
        };

        paraless_combo {
            bindings = <&paraless>;
            key-positions = <27 28 27>;
            layers = <0>;
        };

        paragreat_combo {
            bindings = <&paragreat>;
            key-positions = <31 32>;
            layers = <0>;
        };

        bracket_left_combo {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <15 16>;
        };

        bracket_right_combo {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <19 20>;
        };

        equal_combo {
            bindings = <&kp EQUAL>;
            key-positions = <13 14>;
        };

        minus_combo {
            bindings = <&kp MINUS>;
            key-positions = <21 22>;
        };

        LEFT_BRACE_COMBO {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <4 3>;
        };

        RIGHT_BRACE_COMBO {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <7 8>;
        };
    };

    //

    keymap {
        compatible = "zmk,keymap";

        BASE {
            display-name = "Base";

            // -----------------------------------------------------------------------------------------
            // |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  |
            // |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |
            // |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  |
            // | GUI | CTRL | SHFT | LWR | SPC |   | ENT | RSE  | BKSP | ALT | ESC |

            bindings = <
&kp TAB                           &kp Q               &kp W           &kp E                       &kp R                          &kp T           &kp Y        &kp U              &kp I            &kp O            &kp P           &terminal_tmux_tapdance
&hold_preferred LEFT_SHIFT GRAVE  &hm LEFT_CONTROL A  &hm LEFT_ALT S  &hm LEFT_GUI D              &hm LEFT_SHIFT F               &kp G           &kp H        &hm RIGHT_SHIFT J  &hm RIGHT_GUI K  &hm RIGHT_ALT L  &hm RCTRL SEMI  &hold_preferred RIGHT_SHIFT APOS
&kp EQUAL                         &kp Z               &kp X           &kp C                       &kp V                          &kp B           &kp N        &kp M              &kp COMMA        &kp DOT          &kp FSLH        &kp MINUS
                                                                      &layer_tap_repeat 3 DELETE  &layer_tap_repeat 1 BACKSPACE  &lt 2 ESCAPE    &lt 5 ENTER  &lt 4 SPACE        &key_repeat
            >;
        };

        NAV {
            bindings = <
&trans  &trans            &trans        &trans        &trans          &trans    &kp LG(V)  &kp LG(C)       &kp LG(X)     &kp LG(Z)  &kp LG(LS(Z))  &kp RG(RS(RC(NUMBER_4)))
&trans  &kp LEFT_CONTROL  &kp LEFT_ALT  &kp LEFT_GUI  &kp LEFT_SHIFT  &trans    &kp LEFT   &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT  &caps          &kp RG(RS(NUMBER_4))
&trans  &trans            &trans        &trans        &trans          &trans    &kp HOME   &kp PAGE_DOWN   &kp PAGE_UP   &kp END    &kp INSERT     &to 1
                                        &trans        &trans          &to 0     &trans     &trans          &trans
            >;

            label = "Nav";
        };

        MOUSE {
            bindings = <
&trans  &trans            &trans        &trans        &trans          &trans    &kp LG(V)        &kp LG(C)       &kp LG(X)       &kp LG(Z)        &kp LG(LS(Z))  &trans
&trans  &kp LEFT_CONTROL  &kp LEFT_ALT  &kp LEFT_GUI  &kp LEFT_SHIFT  &trans    &mmv MOVE_LEFT   &mmv MOVE_DOWN  &mmv MOVE_UP    &mmv MOVE_RIGHT  &caps          &trans
&trans  &trans            &trans        &trans        &trans          &trans    &msc SCRL_RIGHT  &msc SCRL_UP    &msc SCRL_DOWN  &msc SCRL_LEFT   &kp INSERT     &to 2
                                        &trans        &trans          &to 0     &mkp RCLK        &mkp LCLK       &mkp MCLK
            >;

            label = "Mouse";
        };

        MEDIA {
            bindings = <
&trans  &trans            &trans        &trans        &trans          &trans    &studio_unlock  &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &trans        &trans        &kp LG(LA(C_POWER))
&trans  &kp LEFT_CONTROL  &kp LEFT_ALT  &kp LEFT_GUI  &kp LEFT_SHIFT  &trans    &kp C_PREVIOUS  &kp C_VOLUME_DOWN     &kp C_VOLUME_UP       &kp C_NEXT    &trans        &trans
&trans  &trans            &trans        &trans        &trans          &trans    &bt BT_SEL 0    &bt BT_SEL 1          &bt BT_SEL 2          &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR
                                        &trans        &trans          &trans    &kp C_STOP      &kp C_PLAY_PAUSE      &kp C_MUTE
            >;

            label = "Media";
        };

        NUM {
            display-name = "Numbers";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            // | GUI | CTRL | SHFT | LWR | SPC |   | ENT | RSE  | BKSP | ALT | ESC |

            bindings = <
&trans  &paraless         &kp N7        &kp N8        &kp N9        &paragreat           &trans  &trans           &trans         &trans         &trans     &trans
&trans  &kp LEFT_BRACKET  &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp RIGHT_BRACKET    &trans  &kp RIGHT_SHIFT  &kp RIGHT_GUI  &kp RIGHT_ALT  &kp RCTRL  &trans
&to 4   &kp BACKSLASH     &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp EQUAL            &trans  &trans           &trans         &trans         &trans     &trans
                                        &kp PERIOD    &kp N0        &kp MINUS            &to 0   &trans           &trans
            >;
        };

        SYM {
            display-name = "Symbols";
            bindings = <
&trans  &kp TILDE         &kp AMPERSAND    &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp PIPE             &trans  &trans           &trans         &trans         &trans     &trans
&trans  &kp LEFT_BRACKET  &kp DOLLAR       &kp PERCENT   &kp CARET             &kp RIGHT_BRACKET    &trans  &kp RIGHT_SHIFT  &kp RIGHT_GUI  &kp RIGHT_ALT  &kp RCTRL  &trans
&to 5   &kp LEFT_BRACE    &kp EXCLAMATION  &kp AT_SIGN   &kp HASH              &kp RIGHT_BRACE      &trans  &trans           &trans         &trans         &trans     &trans
                                           &paraless     &paragreat            &kp UNDERSCORE       &to 0   &trans           &trans
            >;
        };

        Fun {
            display-name = "Function";
            bindings = <
&trans  &kp F12  &kp F7  &kp F8  &kp F9  &trans    &trans  &trans           &trans         &trans         &trans             &trans
&trans  &kp F11  &kp F4  &kp F5  &kp F6  &trans    &trans  &kp RIGHT_SHIFT  &kp RIGHT_GUI  &kp RIGHT_ALT  &kp RIGHT_CONTROL  &kp RA(RC(RS(RIGHT_GUI)))
&trans  &kp F10  &kp F1  &kp F2  &kp F3  &trans    &trans  &trans           &trans         &trans         &trans             &trans
                         &trans  &trans  &trans    &trans  &trans           &trans
            >;
        };

        layer_7 {
            bindings = <
&trans  &kp EXCLAMATION  &kp AT_SIGN    &kp HASH      &kp DOLLAR            &kp PERCENT              &kp ASTERISK  &kp N7        &kp N8        &kp N9        &kp PLUS    &trans
&trans  &kp CARET        &kp AMPERSAND  &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS    &kp SLASH     &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp MINUS   &kp EQUAL
&trans  &trans           &trans         &trans        &trans                &kp BACKSLASH            &kp N0        &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp PERIOD  &trans
                                        &trans        &trans                &trans                   &trans        &trans        &trans
            >;
        };
    };
};
